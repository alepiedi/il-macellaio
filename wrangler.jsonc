// Configurazione per Cloudflare Workers: le pagine sono file statici in public/.
// Il Worker (worker/index.js) rimanda http e www a https://ilmacellaiobn.it e aggiunge header di sicurezza e cache.
// run_worker_first: ogni richiesta passa dal Worker (serve per redirect e header; per un sito piccolo è nei limiti del piano gratis).
{
  "name": "il-macellaio-benevento",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // Dominio comprato su Aruba, con i DNS spostati su Cloudflare: si collega da solo a ogni pubblicazione.
  "routes": [
    { "pattern": "ilmacellaiobn.it", "custom_domain": true },
    { "pattern": "www.ilmacellaiobn.it", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
